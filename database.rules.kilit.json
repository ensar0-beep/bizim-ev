{
  "rules": {
    ".read": false,
    ".write": false,
    "families": {
      "$code": {
        ".read": "auth != null && data.child('uids').child(auth.uid).exists()",
        ".write": "auth != null && $code.matches(/^[A-Z2-9]{8}$/) && (!data.exists() || data.child('uids').child(auth.uid).exists())",
        "meta": {
          ".read": "auth != null && $code.matches(/^[A-Z2-9]{8}$/)",
          ".validate": "!root.child('families').child($code).child('k').exists() || root.child('families').child($code).child('k/st').val() === 'undo' || (newData.isString() && newData.val().beginsWith('e1.'))"
        },
        "members": {
          ".read": "auth != null && $code.matches(/^[A-Z2-9]{8}$/)",
          "$id": {
            ".validate": "!root.child('families').child($code).child('k').exists() || root.child('families').child($code).child('k/st').val() === 'undo' || (newData.isString() && newData.val().beginsWith('e1.'))"
          }
        },
        "uids": {
          "$uid": {
            ".read": "auth != null && $uid === auth.uid",
            ".write": "auth != null && $code.matches(/^[A-Z2-9]{8}$/) && $uid === auth.uid && (!newData.exists() || (newData.isString() && newData.val().length <= 40))"
          }
        },
        "events": {
          "$id": {
            ".validate": "!root.child('families').child($code).child('k').exists() || root.child('families').child($code).child('k/st').val() === 'undo' || (newData.isString() && newData.val().beginsWith('e1.'))"
          }
        },
